# TLS and the only door into the box. Caddy obtains and renews the certificate from Let's Encrypt
# on its own, which is the entire reason it is here rather than an ALB ($16/month for the same job).
#
# Let's Encrypt will not issue a certificate for a bare IP, so {$API_DOMAIN} must be a real hostname
# whose A record already points here. Point DNS first, then start Caddy, or the first run burns a
# failed challenge against a rate limit (5 per hostname per hour).

{$API_DOMAIN} {
	# Sign-in, on the same hostname as the API rather than a subdomain of its own: no second DNS
	# record, no second certificate, and the session cookie is scoped to the parent domain either
	# way. `handle` blocks and not bare matchers, because Caddy orders directives by its own table
	# and not by the order they are written, so two reverse_proxy lines would race.
	handle /api/auth/* {
		reverse_proxy auth:3001 {
			health_uri /health
			health_interval 5s
			health_timeout 2s
		}
	}

	handle {
		# Both upstreams are `vision`, which reads like a typo and is not.
		#
		# Neither backend replica has a network of its own: they join the vision container's namespace
		# (`network_mode: service:vision`, mirroring how ECS co-locates them under awsvpc), because the
		# parser binds 127.0.0.1 and is only ever called from the backend. So the replicas' ports live
		# on the *vision* service's address, and that is where Caddy has to send traffic. Two ports on
		# one host, not two hosts.
		#
		# This pair is what makes a deploy cost no downtime: deploy.sh restarts one replica at a time,
		# and the active health check takes the restarting one out of rotation.
		reverse_proxy vision:8080 vision:8081 {
			lb_policy round_robin

			# Active checks. /health only answers once Flyway has migrated and the module is built, so
			# a passing check means ready, not merely listening.
			health_uri /health
			health_interval 2s
			health_timeout 2s

			# Covers the window between a replica going down and the health check noticing: rather than
			# return 502, try the other upstream. lb_try_duration must exceed health_interval or the
			# gap is not actually covered.
			lb_try_duration 5s
			lb_try_interval 100ms
		}
	}

	# The parser refuses anything larger (MAX_UPLOAD_BYTES, vision/app/main.py). Rejecting it here
	# means a 25 MB upload fails immediately at the edge rather than after crossing the Pacific.
	request_body {
		max_size 20MB
	}

	# The item icons and digit sprites are served unauthenticated off the JAR classpath
	# (staticResources in plugins/Routing.kt) and never change without the filename changing. They
	# are the only genuinely cacheable thing here, and the whole reason Cloudflare is in front.
	@static path /token-icons/* /digit-icons/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cloudflare proxies this, so every request arrives from a Cloudflare IP and the real client is
	# in CF-Connecting-IP. Caddy can only be told to trust those hops with a static range list
	# (the `cloudflare` module is a third-party plugin, not in the stock image), and that list
	# changes, so it is deliberately not pinned here. Read the client IP from CF-Connecting-IP if
	# it ever matters; do not believe the remote address.

	log {
		output stdout
		format console
	}
}
