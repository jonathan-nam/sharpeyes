{
  "name": "sharpeyes",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem"
    },
    // gradle-sdkman is deliberately NOT here. It installs its own JDK -- currently 25 --
    // and makes it the SDKMAN default, and Gradle 8.12 cannot run on 25: every ./gradlew
    // invocation dies with a bare "25.0.3" and no explanation. post-create.sh used to pin
    // the JDK back to 21 afterwards, which worked only when post-create ran, and turned a
    // permanent problem into an intermittent one.
    //
    // The feature was only ever needed to generate gradle-wrapper.jar, a binary the initial
    // scaffolding could not write by hand. That jar has been committed since; ./gradlew is
    // self-contained and needs no Gradle on the PATH at all. So the fix is to stop
    // installing the JDK that breaks it.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  // Only forward the ports that mean something. Without this, VS Code auto-forwards
  // every ephemeral port it notices a process bind -- Gradle daemons, language
  // servers, test harnesses -- and leaves the rows behind after the process exits,
  // so the Ports panel fills with dead entries nobody can interpret.
  "forwardPorts": [3000, 3001, 8080, 5432],
  "portsAttributes": {
    "3000": { "label": "frontend (Next.js)", "onAutoForward": "notify" },
    // Sign-in happens in the BROWSER, which runs on the host, not in this container. Without
    // this the auth service is reachable from inside (curl, the backend) and not from outside,
    // and clicking "Sign in with Discord" fails as a bare "Failed to fetch" with nothing in the
    // service's log, because the request never leaves the browser.
    "3001": { "label": "auth (Better Auth)", "onAutoForward": "silent" },
    "8080": { "label": "backend (Ktor)", "onAutoForward": "silent" },
    "5432": { "label": "postgres", "onAutoForward": "silent" }
  },
  // Everything else -- Gradle daemons, language servers, the vision service on 8000 --
  // is reachable but not worth a row in the panel. Forward it by hand if you need it.
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  // The container's home directory does not survive a rebuild, so credentials stored in
  // it did not either -- `aws configure` and `gh auth login` had to be re-run every time,
  // which is the kind of chore you only notice when it blocks something urgent.
  //
  // Bind them from the host instead. They are the user's credentials, not the project's:
  // they belong to the machine, and the container should borrow them rather than keep its
  // own copy. (VS Code already forwards .gitconfig and SSH agent by itself.)
  //
  // ~/.ssh is on the list for the Lightsail key, which agent forwarding does NOT cover: a
  // deploy runs `ssh -i ~/.ssh/lightsail.pem`, and the file has to be there. Container-local
  // it died with each rebuild, and prod could not be deployed from a session until it was
  // dragged back in by hand. `*.pem` is gitignored and pinned by both ci.yml secret guards.
  //
  // initializeCommand runs on the HOST before the container is created. Without it, a bind
  // mount whose source does not exist fails the whole container build -- which is a
  // spectacular way to break a fresh clone for someone who has never used the AWS CLI.
  // ~/.claude is here for the same reason but matters more: it holds Claude Code's memory
  // and the history of every session. Container-local, it dies with the container -- so a
  // rebuild silently discards everything learned about this machine and this project, and
  // the next session starts by rediscovering it. That is precisely what a memory is for,
  // and precisely what makes losing it expensive.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.aws ${localEnv:HOME}/.config/gh ${localEnv:HOME}/.claude ${localEnv:HOME}/.ssh",
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1"
  },
  "customizations": {
    "vscode": {
      // "detekt.detekt-vscode" used to be listed here. No such extension exists in
      // the marketplace, so every container build was silently failing to install it
      // and nobody noticed. detekt still runs, via Gradle, in the pre-commit hook.
      //
      // ms-python.python + pylance are deliberately absent: VS Code syncs personal
      // extensions in anyway, and pinning them here would also pin their weight on
      // people who never open vision/.
      "extensions": [
        "fwcd.kotlin",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "hashicorp.terraform",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,

        // This is a Kotlin project, but VS Code syncs personal extensions into the
        // container, and redhat.java + vscjava.vscode-gradle arrive that way. Between
        // them they run a Java language server, a Gradle Build Server and a Gradle
        // import daemon: about 160% CPU and 1.7GB of RAM on a 7.7GB VM, for a language
        // this repo barely contains. The visible symptom is that typing in the terminal
        // goes laggy, because the editor is starving it of CPU.
        //
        // Kotlin support is fwcd.kotlin and builds are run from the terminal, so nothing
        // here needs Gradle project import. Turn the expensive parts off rather than
        // relying on everyone to disable the extensions by hand.
        "java.import.gradle.enabled": false,
        "java.gradle.buildServer.enabled": "off",
        "java.autobuild.enabled": false,
        "java.configuration.updateBuildConfiguration": "disabled",
        "java.import.maven.enabled": false,
        "java.compile.nullAnalysis.mode": "disabled",
        "java.jdt.ls.vmargs": "-Xmx512m -XX:MaxMetaspaceSize=256m",

        // Build output churns on every build and holds nothing worth indexing.
        "files.watcherExclude": {
          "**/build/**": true,
          "**/.gradle/**": true,
          "**/node_modules/**": true,
          "**/.next/**": true,
          "**/.terraform/**": true
        },
        "search.exclude": {
          "**/build": true,
          "**/.gradle": true,
          "**/.next": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
