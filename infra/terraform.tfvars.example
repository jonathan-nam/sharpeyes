# Copy to terraform.tfvars (gitignored). Every value below already has a default in variables.tf,
# so this file is only for overriding them.

aws_region        = "us-east-1"
availability_zone = "us-east-1a"
environment       = "prod"

# small_3_0: $12/mo, 2 vCPU, 2 GB. See variables.tf for why not micro_3_0 and not the ipv6 bundles.
bundle_id = "small_3_0"

# Narrow this if you have a fixed IP. SSH is the only port on the box not meant to be public.
# ssh_allowed_cidrs = ["203.0.113.4/32"]

# Auth and the frontend origin are NOT here. They are runtime config for the containers, not
# infrastructure, and they live in the .env on the box (.env.prod.example).
