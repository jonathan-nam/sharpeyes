# Terraform (.terraform.lock.hcl is intentionally NOT ignored -- commit it,
# same reasoning as a package-lock.json: pins exact provider versions)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/*.tfplan
infra/.tflint.d/
# Names the state bucket (embeds the AWS account ID); repo is public.
infra/backend.hcl

# Node / Next.js
# No trailing slash: also ignore a node_modules SYMLINK, not just a directory (a
# symlink here once got committed and clobbered the real one on checkout).
frontend/node_modules
# Unanchored, so a node_modules anywhere else is ignored too. Running a frontend command from the
# repo root instead of frontend/ drops a vitest cache in ./node_modules, and `git add -A` staged it.
node_modules
# pnpm's content-addressable store, which every worktree hardlinks its node_modules out of. It
# has to sit inside the repo: /workspaces is a different filesystem, and a hardlink cannot cross one.
.pnpm-store/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Kotlin / Gradle (gradle-wrapper.jar is intentionally NOT ignored -- commit
# it, that's the entire point of the wrapper: reproducible builds with no
# pre-installed Gradle required)
backend/.gradle/
backend/build/
backend/*/build/
# Kotlin's incremental build cache, written beside the source tree by `gradlew run`.
backend/.kotlin/
backend/*/.kotlin/

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
vision/**/__pycache__/
vision/.pytest_cache/

# Local CV/vision virtualenv
.venv-cv/
__pycache__/
*.pyc
symbol-candidates.png

# Environment files, anywhere in the tree. This repo is public and the root .env is the PROD one
# on the box: AUTH_SECRET, the Discord client secret and the S3 backup keys (see .env.prod.example).
#
# The bare name alone left `.env.prod` committable, which is the name `.env.prod.example` invites
# you to copy it to. So match every suffix and negate the examples back in. Pinned by the
# "No secret files committed" step in ci.yml, which also catches a `git add -f`.
.env
.env.*
!.env*.example

# Clerk's local config, which can carry a secret key. Repo-wide, not just frontend/.
.clerk/

# SSH private keys. docs/deploy.md tells you to download the Lightsail key to reach the box, so a
# .pem in the tree is a step in the runbook, not an accident. Repo is public, so it must never be
# stageable. Pinned by the two secret-file steps in ci.yml.
*.pem
*.key
id_rsa*
id_ed25519*

# Dev database dumps. This repo is public and a dump carries the account and Discord rows of whoever
# took it, so a dump must never be committable by an absent-minded `git add -A`.
dev-snapshots/

# stray build output if next is run from the wrong cwd
**/.next/

# The dist dir next.config tells you to use so a production build does not poison the running dev
# server (NEXT_DIST_DIR=.next-prod). It was not ignored, so following that advice staged 300 files.
**/.next-prod/

# Scratch drop zone for reference captures. Nothing here is a fixture until a
# test reads it, at which point it moves up into test-fixtures/ proper.
test-fixtures/scratch/*
!test-fixtures/scratch/README.md

# The auth service's compiled output. Built in the image, never committed.
auth/dist
