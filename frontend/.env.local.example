# Copy to .env.local (gitignored):  cp frontend/.env.local.example frontend/.env.local

# Where the Ktor backend is.
#
# Locally that is the backend container, which publishes 8080 (via the vision container
# -- they share a network namespace, mirroring how ECS co-locates them). The value below
# is correct for local development as-is; nothing to change.
#
# In production this is api.sharpeyes.gg.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Where the auth service is, as the BROWSER reaches it. Sign-in is a redirect the user's browser
# follows, so a container hostname is wrong here even though the backend uses one.
#
# It has to match the auth service's own AUTH_BASE_URL exactly. In production both are
# https://api.sharpeyes.gg, since Caddy serves sign-in from the API hostname under /api/auth.
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3001
